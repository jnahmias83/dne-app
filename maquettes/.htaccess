# Maquettes : jamais de cache navigateur (toujours la derniere version)
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
  # jamais dans Google / les moteurs de recherche
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Pas de liste des fichiers du dossier
Options -Indexes

# Sources du design (inc, scripts, aide-memoire, mots de passe) : jamais servies par le serveur
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^(dne\.local|localhost|127\.0\.0\.1)$
  RewriteRule ^_design(/|$) - [F,L]
  # mots de passe : interdits partout, meme en local
  RewriteRule \.secret - [F,L]
</IfModule>

# Pas de mot de passe (choix de l'utilisateur, 2026-11-24) : les maquettes sont ouvertes a qui a l'adresse.
# Elles ne peuvent rien enregistrer (blocage dans chaque page) et ne sont pas indexees (noindex ci-dessus).
